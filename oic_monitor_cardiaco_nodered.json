  {
    "id": "in_bpm",
    "type": "mqtt in",
    "name": "BPM (ecg/dayane/bpm)",
    "topic": "ecg/dayane/bpm",
    "qos": "0",
    "datatype": "json",
    "broker": "broker_mosq",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 160,
    "wires": [
