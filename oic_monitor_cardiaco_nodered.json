  {
    "id": "fn_med_inicia",
    "type": "function",
    "name": "Inicia medição",
    "func": "// Inicia medição: guarda o instante do comando e envia a faixa 40–50\nconst faixa = { min: 40, max: 50 };\nflow.set(\"t_comando\", Date.now());\nflow.set(\"faixa\", faixa);\nnode.status({ fill: \"blue\", shape: \"ring\", text: \"aguardando alerta ON...\" });\nreturn [\n    { topic: \"ecg/dayane/config/faixa\", payload: faixa },\n    { payload: \"40 a 50 BPM (medição)\" }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 470,
    "y": 1280,
    "wires": [
      [
        "out_faixa"
      ],
      [
        "ui_faixa_atual"
      ]
    ],
    "z": "tab_oic"
  },
  {
    "id": "fn_med_calcula",
    "type": "function",
    "name": "Calcula tempo do atuador",
    "func": "// Calcula tempo: comando enviado -> alerta ON recebido do ESP32\nif (String(msg.payload).trim().toUpperCase() !== \"ON\") return null;\nconst t0 = flow.get(\"t_comando\");\nif (!t0) return null;                  // ON que não veio de uma medição\nflow.set(\"t_comando\", null);\n\nconst dt = Date.now() - t0;\nconst lista = flow.get(\"med_atuador\") || [];\nlista.push(dt);\nif (lista.length > 4) lista.shift();   // guarda as 4 últimas\nflow.set(\"med_atuador\", lista);\n\nconst media = lista.reduce((a, b) => a + b, 0) / lista.length;\nnode.status({ fill: \"green\", shape: \"dot\", text: `${dt} ms (média ${media.toFixed(0)} ms)` });\nreturn {\n    payload: lista.map((v, i) => `#${i + 1}: ${v} ms`).join(\"  |  \") + `  |  média: ${media.toFixed(0)} ms`,\n    medicoes: lista,\n    media: media\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 470,
    "y": 1340,
    "wires": [
      [
        "ui_med",
        "dbg_med"
      ]
    ],
    "z": "tab_oic"
  },
