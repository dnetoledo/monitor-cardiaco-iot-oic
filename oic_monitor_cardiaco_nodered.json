    "type": "function",
    "name": "Formata eletrodos",
    "func": "// Formata eletrodos: \"OK\" / \"SOLTO\"\nconst v = String(msg.payload).trim().toUpperCase();\nif (v === \"OK\") {\n    node.status({ fill: \"green\", shape: \"dot\", text: \"conectados\" });\n    return { payload: \"Conectados\" };\n}\nif (v === \"SOLTO\") {\n    node.status({ fill: \"yellow\", shape: \"dot\", text: \"eletrodo solto\" });\n    return { payload: \"Solto – BPM suspenso\" };\n}\nnode.warn(\"Valor de eletrodos desconhecido: \" + msg.payload);\nreturn null;",
