  {
    "id": "fn_alerta",
    "type": "function",
    "name": "Formata alerta",
    "func": "// Formata alerta: \"ON\" / \"OFF\" -> texto do painel\nconst v = String(msg.payload).trim().toUpperCase();\nif (v === \"ON\") {\n    node.status({ fill: \"red\", shape: \"dot\", text: \"ALERTA ATIVO\" });\n    return [\n        { payload: \"ATIVO (fora da faixa > 5 s)\" },\n        { payload: \"Alerta: frequência cardíaca fora da faixa segura!\" }  // aviso pop-up\n    ];\n}\nif (v === \"OFF\") {\n    node.status({ fill: \"green\", shape: \"ring\", text: \"sem alerta\" });\n    return [{ payload: \"Desligado\" }, null];\n}\nnode.warn(\"Valor de alerta desconhecido: \" + msg.payload);\nreturn null;",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 430,
    "y": 340,
