    "type": "function",
    "name": "Monta faixa",
    "func": "// Monta faixa: valida o formulário e prepara a mensagem MQTT\n// Entrada: msg.payload = { min: \"55\", max: \"110\" }\nconst min = Number(msg.payload.min);\nconst max = Number(msg.payload.max);\n\nif (!Number.isFinite(min) || !Number.isFinite(max) || min < 30 || max > 220 || min >= max) {\n    const erro = \"Faixa inválida: use números entre 30 e 220, com mínimo menor que o máximo.\";\n    node.status({ fill: \"red\", shape: \"ring\", text: \"faixa inválida\" });\n    return [null, null, { payload: erro }];\n}\n\nconst faixa = { min: min, max: max };\nflow.set(\"faixa\", faixa);               // usada pelo nó \"Verifica BPM\"\nnode.status({ fill: \"green\", shape: \"dot\", text: `enviada: ${min}–${max}` });\n\nreturn [\n    { topic: \"ecg/dayane/config/faixa\", payload: faixa },   // -> MQTT out (vira {\"min\":..,\"max\":..})\n    { payload: `${min} a ${max} BPM` },                    // -> texto \"Faixa atual\"\n    { payload: `Nova faixa enviada ao ESP32: ${min}–${max} BPM` }  // -> aviso\n];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "",
    "x": 430,
    "y": 700,
    "wires": [
      [
        "out_faixa",
        "dbg_faixa"
      ],
      [
        "ui_faixa_atual"
      ],
      [
        "ui_notif"
      ]
    ],
    "z": "tab_oic"
