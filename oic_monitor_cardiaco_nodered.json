  {
    "id": "fn_verifica",
    "type": "function",
    "name": "Verifica BPM",
    "func": "// Verifica BPM\n// Entrada: msg.payload = {\"bpm\": 72}  (tópico ecg/dayane/bpm)\n// Saída 1: número do BPM -> medidor e gráfico\n// Saída 2: texto da situação -> painel\n\nconst bpm = Number(msg.payload && msg.payload.bpm);\nif (!Number.isFinite(bpm)) {\n    node.warn(\"Mensagem de BPM inválida: \" + JSON.stringify(msg.payload));\n    return null;\n}\n\n// Faixa segura atual (padrão 60–100 BPM, alterada pelo formulário do painel)\nconst faixa = flow.get(\"faixa\") || { min: 60, max: 100 };\n\nlet situacao;\nlet dentro = false;\nif (bpm < faixa.min) {\n    situacao = `Abaixo da faixa (${faixa.min}–${faixa.max} BPM)`;\n} else if (bpm > faixa.max) {\n    situacao = `Acima da faixa (${faixa.min}–${faixa.max} BPM)`;\n} else {\n    situacao = \"Dentro da faixa\";\n    dentro = true;\n}\n\n// Mostra o resultado embaixo do nó, no editor\nnode.status({ fill: dentro ? \"green\" : \"red\", shape: \"dot\", text: `${bpm} BPM – ${situacao}` });\n\nreturn [\n    { payload: bpm, topic: \"BPM\" },\n    { payload: situacao }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "info": "Compara o BPM recebido com a faixa segura (flow.faixa).",
    "x": 420,
    "y": 160,
    "wires": [
      [
        "ui_gauge",
        "ui_chart"
      ],
      [
        "ui_situacao"
      ]
    ],
    "z": "tab_oic"
  },
